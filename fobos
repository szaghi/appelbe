[project]
name       = appelbe
summary    = Reproduction of Appelbe et al., Phys. Plasmas 26, 102704 (2019), Secs. IV-VI
repository = https://github.com/szaghi/appelbe
authors    = "Federico Negro" "Luca Senni" "Stefano Zaghi"
license    = GPL-3.0-only

# managed boilerplate (fobis scaffold status|sync): CI and docs in the linux-gnu image of fortran-toolchains; the
# installer (scripts/install.sh) uses its default modes, static-gnu, static-intel and static-nvf, all defined below
[scaffold]
toolchain = linux-gnu

[dependencies]
deps_dir = src/third_party
PENF     = https://github.com/szaghi/PENF :: branch=master

[modes]
modes = gnu gnu-debug tests-gnu tests-gnu-debug static-gnu static-intel static-nvf

[common-variables]
$CFLAGS_GNU = -c -frealloc-lhs -ffree-line-length-132
$OPT_GNU    = -O2
$DEBUG_GNU  = -O0 -g3 -Wall -Wextra -Wimplicit-interface -fcheck=all -fbacktrace -finit-real=snan -ffpe-trap=invalid,zero,overflow
$CFLAGS_INT = -c -assume realloc_lhs -O2
$CFLAGS_NVF = -c -O2
# PENF is scanned as sources (use=sources): only its library, not its tests, scripts or docs
$EXDIRS     = ./src/third_party/PENF/src/tests ./src/third_party/PENF/scripts ./src/third_party/PENF/docs

[template-base]
src             = ./src/lib/
exclude_dirs    = $EXDIRS
mod_dir         = ./mod/
obj_dir         = ./obj/
cflags_heritage = True
colors          = True
jobs            = 4

# the reproduction drivers (src/app/appelbe_*) into bin/
[template-drivers]
template  = template-base
compiler  = gnu
src       = ./src/lib/ ./src/app/
build_dir = ./bin/

# the test programs (src/tests/test_*) into exe/, where scripts/run_tests.sh runs every executable
[template-tests]
template  = template-base
compiler  = gnu
src       = ./src/lib/ ./src/tests/
build_dir = ./exe/

# the library alone: lib/libappelbe.a and its modules in lib/mod (use appelbe)
[template-static]
template  = template-base
build_dir = ./lib/
target    = appelbe.F90
output    = libappelbe.a
mklib     = static

[gnu]
template = template-drivers
cflags   = $CFLAGS_GNU $OPT_GNU

[gnu-debug]
template = template-drivers
cflags   = $CFLAGS_GNU $DEBUG_GNU

[tests-gnu]
template = template-tests
cflags   = $CFLAGS_GNU $OPT_GNU

[tests-gnu-debug]
template = template-tests
cflags   = $CFLAGS_GNU $DEBUG_GNU

[static-gnu]
template = template-static
compiler = gnu
cflags   = $CFLAGS_GNU $OPT_GNU

[static-intel]
template = template-static
compiler = intel_nextgen
cflags   = $CFLAGS_INT

[static-nvf]
template = template-static
compiler = nvfortran
cflags   = $CFLAGS_NVF

[rule-tests]
help = Run every test program in exe/ (build first: fobis build --mode tests-gnu)
rule = bash scripts/run_tests.sh

[rule-figures]
help = Run every reproduction driver in bin/ and plot the results with gnuplot (build first: fobis build --mode gnu)
rule = bash scripts/make_figures.sh

[rule-makecoverage]
help   = Build the tests with coverage (tests-gnu-debug), run them, write docs/public/coverage.json (the library only:
         PENF and the test programs are dropped)
rule_1 = fobis build --mode tests-gnu-debug --coverage --force-compile
rule_2 = bash scripts/run_tests.sh
rule_3 = bash -c 'rm -f exe/obj/penf*.gcda exe/obj/test_*.gcda exe/obj/appelbe_assert.gcda'
rule_4 = bash scripts/compute-coverage.sh

[rule-makecoverage-analysis]
help   = The coverage, then its report in docs/guide/ (what CI runs)
rule_1 = fobis rule --ex makecoverage
rule_2 = fobis rule --gcov-analyzer docs/guide/ --gcov-analyzer coverage-analysis
rule_3 = bash -c 'rm -f *.gcov parsed.xml source.xml'

[rule-docs-examples]
help = Build and run the documentation examples: docs/examples/{snippets,output}
rule = python3 scripts/docs_examples.py

[rule-report]
help = Generate report numbers/tables from results/ and compile report/appelbe_report.pdf (run figures first)
rule = bash scripts/make_report.sh
