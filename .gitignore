references/*
# build artifacts (fobis build: tests in exe/, drivers in bin/, each with its objects and modules)
exe/
/bin/
mod/
obj/
# the static library (fobis build --mode static-gnu) and scratch builds (scripts/docs_examples.py)
/lib/
/build/
# fetched dependencies (fobis fetch)
src/third_party/
# generated by the drivers (fobis rule --ex figures)
results/
# report build by-products (fobis rule --ex report); report/generated/ is regenerated from results/
report/generated/
report/figures/
report/*.aux
report/*.log
report/*.fls
report/*.fdb_latexmk
report/*.out
report/*.toc
report/*.auxlock
# Python bytecode
__pycache__/
# documentation site (VitePress): dependencies, caches and build; docs/api/ is regenerated by formal
docs/node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/api/
# coverage (fobis rule --ex makecoverage-analysis; CI packs them for the docs)
*.gcov
*.gcda
*.gcno
docs/public/coverage.json
docs/guide/coverage-analysis.md
docs/guide/*.gcov.md
