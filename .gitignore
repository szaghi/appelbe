references/*
# build artifacts (fobis build: objects and modules land under exe/)
exe/
mod/
obj/
# the static library (fobis build --mode static-gnu) and scratch builds (scripts/docs_examples.py)
/lib/
/build/
# fetched dependencies (fobis fetch)
src/third_party/
# generated by the drivers (fobis rule --ex figures)
results/
# report build by-products (fobis rule --ex report); report/generated/ is regenerated from results/
report/generated/
report/*.aux
report/*.log
report/*.fls
report/*.fdb_latexmk
report/*.out
report/*.toc
# Python bytecode
__pycache__/
# documentation site (VitePress): dependencies, caches and build; docs/api/ is regenerated by formal
docs/node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/api/
